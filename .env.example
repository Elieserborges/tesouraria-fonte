# ------------------------------------------------------------------
# Supabase — Project Settings > API
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Chave service_role. NUNCA use prefixo NEXT_PUBLIC_ e nunca comite.
# Usada só no webhook (server-side) para gravar ignorando o RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ------------------------------------------------------------------
# Mercado Pago — uma credencial por conta do Mercado Pago.
# O sufixo é o slug da conta (tabela `contas`), em MAIÚSCULAS e com "-" -> "_".
# Ex.: slug "conta-1"  ->  MP_ACCESS_TOKEN_CONTA_1
#
# Access token: Suas integrações > sua aplicação > Credenciais de produção
# Webhook secret: Suas integrações > sua aplicação > Webhooks > Assinatura secreta
# URL para cadastrar no painel do Mercado Pago:
#   https://SEU-DOMINIO/api/webhooks/mercadopago/conta-1
# ------------------------------------------------------------------
MP_ACCESS_TOKEN_CONTA_1=APP_USR-...
MP_WEBHOOK_SECRET_CONTA_1=...

# Para uma segunda conta, cadastre-a no sistema com o slug "conta-2" e
# acrescente MP_ACCESS_TOKEN_CONTA_2 / MP_WEBHOOK_SECRET_CONTA_2 aqui.

# ------------------------------------------------------------------
# Segredo do Vercel Cron. Gere qualquer string longa e aleatória.
# A Vercel envia este valor no cabeçalho Authorization ao disparar
# a sincronização agendada; sem ele a rota responde 401.
# ------------------------------------------------------------------
CRON_SECRET=
